{
  "Main Function": {
    "prefix": "main",
    "body": ["func main()", "block", "\t$0", "end"],
    "description": "Main entry point block"
  },
  "Function Definition": {
    "prefix": "func",
    "body": ["func ${1:name}(${2:params})", "block", "\t$0", "end"],
    "description": "Function definition"
  },
  "Typed Function Definition": {
    "prefix": "tfunc",
    "body": [
      "${1|#,%,@,$|}func ${2:name}(${3:params})",
      "block",
      "\t$0",
      "end"
    ],
    "description": "Typed function definition"
  },
  "Block Statement": {
    "prefix": "block",
    "body": ["block", "\t$0", "end"],
    "description": "Code block"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if (${1:condition})", "block", "\t$0", "end"],
    "description": "If condition block"
  },
  "If-Elif-Else Statement": {
    "prefix": "ifel",
    "body": [
      "if (${1:condition})",
      "block",
      "\t$2",
      "end",
      "elif (${3:condition})",
      "block",
      "\t$4",
      "end",
      "else",
      "block",
      "\t$0",
      "end"
    ],
    "description": "If / Elif / Else block"
  },
  "During Loop (While)": {
    "prefix": "during",
    "body": [
      "during (${1:left} ${2:operator} ${3:right})",
      "block",
      "\t$0",
      "end"
    ],
    "description": "During loop (while condition)"
  },
  "Repeat Loop (For)": {
    "prefix": "repeat",
    "body": [
      "repeat (${1:init}, ${2:condition}, ${3:step})",
      "block",
      "\t$0",
      "end"
    ],
    "description": "Repeat loop (initialize, condition, step)"
  },
  "Count Switch Block": {
    "prefix": "count",
    "body": [
      "count (${1:variable})",
      "block",
      "\targ ${2:value}:",
      "\t\t$3",
      "\t\tsend",
      "\tincase:",
      "\t\t$0",
      "end"
    ],
    "description": "Count switch block with arg cases and incase default"
  },
  "Arg Case": {
    "prefix": "arg",
    "body": ["arg ${1:value}:", "\t$0", "\tsend"],
    "description": "Arg case statement inside count block"
  },
  "Attempt / Incase (Error Handling)": {
    "prefix": "attempt",
    "body": [
      "attempt",
      "block",
      "\t$1",
      "end",
      "incase",
      "block",
      "\t$0",
      "end"
    ],
    "description": "Error handling try/catch block"
  },
  "Using Module Import": {
    "prefix": "using",
    "body": ["using ${1|boolean,terminal|}"],
    "description": "Import module with using"
  },
  "Terminal Output": {
    "prefix": "out",
    "body": ["terminal.out(${1:data});"],
    "description": "Print to stdout via terminal"
  },
  "Terminal Input": {
    "prefix": "in",
    "body": ["terminal.in(${1:buffer});"],
    "description": "Read from stdin via terminal"
  },
  "Integer Variable": {
    "prefix": "varint",
    "body": ["#${1:num} = ${2:0};"],
    "description": "Declare integer variable (#)"
  },
  "Float Variable": {
    "prefix": "varfloat",
    "body": ["%${1:val} = ${2:0.0};"],
    "description": "Declare decimal variable (%)"
  },
  "String Variable": {
    "prefix": "varstr",
    "body": ["@${1:str} = \"${2}\";"],
    "description": "Declare string variable (@)"
  },
  "Nil Variable": {
    "prefix": "varnil",
    "body": ["$${1:var} = nil;"],
    "description": "Declare nil variable ($)"
  },
  "Constant Definition": {
    "prefix": "const",
    "body": ["?${1:CCp} = ${2:value};"],
    "description": "Declare constant qualifier (?)"
  },
  "Line Comment Header": {
    "prefix": "header",
    "body": [
      ";- ===========================================",
      ";- $1",
      ";- ===========================================",
      "$0"
    ],
    "description": "Inserts a block comment section header"
  },
  "Block Comment": {
    "prefix": "comment",
    "body": [";- $1 -;"],
    "description": "Inserts a single-line block comment"
  }
}
