{
  "Main Function": {
    "prefix": "main",
    "body": [
      "${1|$|}func main(${2:}) {",
      "\t$0",
      "}"
    ],
    "description": "Main function block"
  },
  "Typed Function": {
    "prefix": "func",
    "body": [
      "${1|#,%,@,$|}func ${2:name}(${3:params}) {",
      "\t$0",
      "}"
    ],
    "description": "Typed function with curly braces"
  },
  "Count Switch Block": {
    "prefix": "count",
    "body": [
      "count (${1:variable}) {",
      "\targ ${2:value}:",
      "\t\t$3",
      "\t\tend",
      "\tincase:",
      "\t\t$4",
      "\t\tend",
      "}"
    ],
    "description": "Count block using curly braces and end markers"
  },
  "Arg Case": {
    "prefix": "arg",
    "body": [
      "arg ${1:value}:",
      "\t$0",
      "\tend"
    ],
    "description": "Arg case statement inside count block"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:value} ${2:compare} ${3:expression} {",
      "\t$0",
      "}"
    ],
    "description": "If statement with braces"
  },
  "Elif Statement": {
    "prefix": "elif",
    "body": [
      "elif ${1:value} ${2:compare} ${3:expression} {",
      "\t$0",
      "}"
    ],
    "description": "Elif statement with braces"
  },
  "Else Statement": {
    "prefix": "else",
    "body": [
      "else {",
      "\t$0",
      "}"
    ],
    "description": "Else block with braces"
  },
  "Repeat Loop": {
    "prefix": "repeat",
    "body": [
      "repeat (${1:}, ${2:}, ${3:}) {",
      "\t$0",
      "}"
    ],
    "description": "Repeat loop with braces"
  },
  "During Loop": {
    "prefix": "during",
    "body": [
      "during (${1:}) {",
      "\t$0",
      "}"
    ],
    "description": "During loop with braces"
  },
  "Using Import": {
    "prefix": "using",
    "body": [
      "using ${1|boolean,terminal|}"
    ],
    "description": "Import library statement"
  },
  "Terminal Output": {
    "prefix": "terminal.out",
    "body": [
      "terminal.out(${1:})"
    ],
    "description": "Terminal print output"
  },
  "Terminal Input": {
    "prefix": "terminal.in",
    "body": [
      "terminal.in(${1|#,%,@|})"
    ],
    "description": "Terminal read input",
    "scope": "support.function.terminal.night"
  }
}