{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Night",
  "scopeName": "source.n",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#typed-functions" },
    { "include": "#type-declarations" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.night",
          "begin": ";-",
          "end": "-;",
          "captures": {
            "0": { "name": "punctuation.definition.comment.night" }
          }
        },
        {
          "name": "comment.line.semicolon.night",
          "match": ";.*$",
          "captures": {
            "0": { "name": "punctuation.definition.comment.night" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.night",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.night", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.night",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.night", "match": "\\\\." }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.night",
          "match": "\\b(if|elif|else|during|repeat|count|arg|incase|attempt|send|end|kill|break|continue|main)\\b"
        },
        {
          "name": "keyword.other.using.night",
          "match": "\\b(using)\\b"
        },
        {
          "name": "entity.name.namespace.night",
          "match": "(?<=using\\s+)\\b(boolean|terminal|file)\\b"
        },
        {
          "name": "entity.name.namespace.night",
          "match": "\\b(terminal|boolean)(?=\\.)"
        },
        {
          "name": "entity.name.namespace.night",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "support.function.terminal.night",
          "match": "(?<=terminal\\.)(out|in|nl)\\b"
        },
        {
          "name": "constant.language.night",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "typed-functions": {
      "patterns": [
        {
          "captures": {
            "1": { "name": "storage.type.symbol.night" },
            "2": { "name": "storage.type.keyword.night" },
            "3": { "name": "entity.name.function.night" }
          },
          "match": "([#%@$?])\\s*(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "captures": {
            "1": { "name": "storage.type.symbol.night" },
            "2": { "name": "variable.other.typed.night" }
          },
          "match": "([#%@$])\\s*([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "captures": {
            "1": { "name": "storage.type.symbol.night" },
            "2": { "name": "entity.name.type.constant.night" }
          },
          "match": "(\\?)\\s*([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "name": "storage.type.symbol.night",
          "match": "[#%@$?]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.type.symbol.pointer.night",
          "match": "->>>|->>|->|<<<-|<<-|<-"
        },
        {
          "name": "keyword.operator.logical.night",
          "match": "(?<=\\s)\\.(?=\\s)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "keyword.other.boolean.night",
          "match": "\\b[01]\\b"
        },
        {
          "name": "constant.numeric.night",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "storage.type.keyword.night",
          "match": "\\b(func)\\b"
        },
        {
          "name": "entity.name.function.night",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  }
}
