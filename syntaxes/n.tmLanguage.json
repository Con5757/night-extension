{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Night",
  "scopeName": "source.n",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#type-declarations" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.night",
          "begin": ";-",
          "end": "-;",
          "captures": {
            "0": { "name": "punctuation.definition.comment.night" }
          }
        },
        {
          "name": "comment.line.semicolon.night",
          "match": ";.*$",
          "captures": {
            "0": { "name": "punctuation.definition.comment.night" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.night",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.night",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.night",
          "match": "\\b(if|elif|else|during|repeat|count|arg|incase|attempt|block|send|break|continue|main)\\b"
        },
        {
          "name": "keyword.other.using.night",
          "match": "\\b(using|terminal)\\b"
        },
        {
          "name": "support.type.module.night",
          "match": "\\b(boolean)\\b"
        },
        {
          "name": "support.function.terminal.night",
          "match": "(?<=terminal\\.)(out|in)\\b"
        },
        {
          "name": "constant.language.boolean.night",
          "match": "(?<=using\\s+boolean[\\s\\S]*?)\\b(true|false|nil)\\b"
        }
      ]
    },
    "type-declarations": {
      "patterns": [
        {
          "name": "storage.type.symbol.night",
          "match": "[#%@$?]"
        },
        {
          "captures": {
            "1": { "name": "storage.type.symbol.night" },
            "2": { "name": "entity.name.function.typed.night" }
          },
          "match": "([#%@$])\\s*([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        },
        {
          "captures": {
            "1": { "name": "storage.type.symbol.night" },
            "2": { "name": "variable.other.typed.night" }
          },
          "match": "([#%@$])\\s*([a-zA-Z_][a-zA-Z0-9_]*)"
        },
        {
          "captures": {
            "1": { "name": "storage.type.symbol.night" },
            "2": { "name": "entity.name.type.constant.night" }
          },
          "match": "(\\?)\\s*([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pointer.night",
          "match": "->\\+|\\+<-"
        },
        {
          "name": "keyword.operator.logical.night",
          "match": "(?<=\\s)\\.(?=\\s)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.language.boolean.numeric.night",
          "match": "\\b[01]\\b"
        },
        {
          "name": "constant.numeric.night",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.night",
          "match": "\\b(func)\\b"
        },
        {
          "name": "entity.name.function.night",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  }
}
